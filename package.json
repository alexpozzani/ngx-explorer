{
  "name": "explorer-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build:lib": "ng build ngx-explorer && npm run copy",
    "build:watch": "ng build ngx-explorer --watch",
    "build": "ng build",
    "build:gh": "ng build --base-href=/ngx-explorer/",
    "pack": "rm -rf dist && ng build ngx-explorer && npm run copy && cd dist/ngx-explorer && npm pack",
    "copy": "cp README.md dist/ngx-explorer/",
    "test": "ng test",
    "prettier": "prettier --write .",
    "lint": "eslint . --ext .ts --fix",
    "semantic-release": "semantic-release"
  },
  "private": false,
  "license": "Apache-2.0",
  "dependencies": {
    "@angular/animations": "^20.0.6",
    "@angular/common": "^20.0.6",
    "@angular/compiler": "^20.0.6",
    "@angular/core": "^20.0.6",
    "@angular/platform-browser": "^20.0.6",
    "@angular/platform-browser-dynamic": "^20.0.6",
    "@angular/router": "^20.0.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^20.0.6",
    "@angular/cli": "^20.0.6",
    "@angular/compiler-cli": "^20.0.6",
    "@types/jasmine": "~5.1.0",
    "eslint": "^8.56.0",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^20.1.0",
    "prettier": "^3.0.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^7.0.2"
  }
}